{
  "name": "@urgorri/goldsrc-bsp-viewer",
  "private": false,
  "version": "1.1.1",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "High-performance, framework-agnostic GoldSrc (Half-Life) BSP map viewer library built with Three.js and optional React support.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Gastón Urgorri <urgorrigaston@gmail.com> (https://github.com/urgorri)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/urgorri/goldsrc-bsp-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/urgorri/goldsrc-bsp-viewer/issues"
  },
  "homepage": "https://urgorri.github.io/goldsrc-bsp-viewer/",
  "main": "./dist/goldsrc-bsp-viewer.umd.cjs",
  "module": "./dist/goldsrc-bsp-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/goldsrc-bsp-viewer.js",
      "require": "./dist/goldsrc-bsp-viewer.umd.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "goldsrc",
    "bsp-viewer",
    "threejs",
    "react",
    "webgl",
    "half-life",
    "bsp",
    "retro-gaming"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.0",
    "three": "^0.172.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "lucide-react": "^0.474.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "three": ">=0.137.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  }
}
